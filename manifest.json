{
  "manifest_version": 3,
  "name": "ListingLens — AI for Realtors",
  "version": "2.2.0",
  "description": "AI listing analysis on Zillow, Realtor.com & Redfin. Price score, red flags, offer generator, and client email in seconds.",
  "permissions": [
    "storage",
    "scripting",
    "tabs"
  ],
  "host_permissions": [
    "https://www.zillow.com/*",
    "https://www.realtor.com/*",
    "https://www.redfin.com/*",
    "https://www.redfin.ca/*",
    "https://listinglens-api.bison-animol.workers.dev/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.zillow.com/homedetails/*",
        "https://www.realtor.com/realestateandhomes-detail/*",
        "https://www.redfin.com/*/home/*",
        "https://www.redfin.ca/*/home/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_end"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  }
}
